{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "koseiwebsite-didb.vercel.app" }],
      "destination": "https://koseimarseille.fr/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/font/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
